# Pre-Registration Reference Architecture - Environment Defaults
# Copy this file to .env and edit it to deploy (see README.md)
# Then run: ./deploy.sh

# Yubico Enterprise Delivery API Token (REQUIRED)
# Get from: https://console.dev.yubico.com
DOWNSTREAM_API_TOKEN=

# Service URLs
CLIENT_URL=http://localhost
KEYCLOAK_URL=http://localhost:8082
GATEWAY_URL=http://localhost:8086
CORS_ALLOWED_ORIGINS=http://localhost
ADDRESS_VALIDATION_SERVICE_URL=https://iap-piercer.graywave-eec1246c.westus2.azurecontainerapps.io

# Keycloak credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Ports (change if conflicts)
CLIENT_PORT=80
GATEWAY_PORT=8086
KEYCLOAK_PORT=8082
